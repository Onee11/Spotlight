<Window x:Class="SpotlightWin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight Settings" 
        Height="430" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Spotlight Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Hotkey Section -->
            <TextBlock Text="Global Hotkey Shortcut:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <TextBox x:Name="HotkeyInputBox" 
                     FontSize="15" FontWeight="SemiBold" 
                     Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Background="#2D2D2D" Foreground="#00FFC8" BorderBrush="#555555" BorderThickness="1"
                     IsReadOnly="True" Cursor="Hand"
                     PreviewKeyDown="HotkeyInputBox_PreviewKeyDown"
                     Margin="0,0,0,15"/>

            <!-- Window Opacity Slider Section -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="Window Opacity:" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Left"/>
                <TextBlock x:Name="OpacityValueText" Text="90%" FontSize="14" FontWeight="Bold" Foreground="#00FFC8" HorizontalAlignment="Right"/>
            </Grid>
            
            <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1.0" Value="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,15"/>

            <!-- Gemini AI API Key Section -->
            <TextBlock Text="Gemini AI API Key (Free):" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,2"/>
            <TextBlock Text="Get a free key from aistudio.google.com to enable 'ai &lt;prompt&gt;'" FontSize="11" Foreground="#777777" Margin="0,0,0,6"/>
            <TextBox x:Name="GeminiApiKeyInputBox" 
                     FontSize="13" 
                     Height="34" VerticalContentAlignment="Center"
                     Background="#2D2D2D" Foreground="#00FFC8" BorderBrush="#555555" BorderThickness="1"
                     Padding="8,0"
                     Margin="0,0,0,20"/>

            <!-- Save Button -->
            <Button Content="Save &amp; Apply" Click="SaveButton_Click" Height="40" FontSize="14" FontWeight="Bold"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>