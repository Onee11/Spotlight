<Window x:Class="SpotlightWin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniLaunch" 
        Height="600" Width="840"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Activated="Window_Activated">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    
    <Border Background="#CC1E1E1E" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Header Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="22" Foreground="White" Background="Transparent" 
                         BorderThickness="0" VerticalContentAlignment="Center" Padding="20,0,10,0"
                         CaretBrush="White" x:Name="SearchBox"
                         PreviewKeyDown="SearchBox_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExecuteSelectedCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- 🎙️ Mic Button / Status Indicator -->
                <Button Grid.Column="1" x:Name="MicButton" Click="MicButton_Click"
                        Margin="0,0,15,0" Width="36" Height="36" 
                        Background="#22FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock x:Name="MicStatusIcon" Text="🎙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
                     
            <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#33FFFFFF"/>
            
            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="0,5,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />         <!-- Results List -->
                    <ColumnDefinition Width="Auto" />      <!-- Formatted AI Preview Pane -->
                </Grid.ColumnDefinitions>

                <!-- Search Results List -->
                <ListBox Grid.Column="0" 
                         x:Name="ResultsListBox"
                         ItemsSource="{Binding Results}" 
                         SelectedItem="{Binding SelectedResult}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ResultsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Rectangle Width="24" Height="24" Fill="#22FFFFFF" RadiusX="4" RadiusY="4"/>
                                        <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="5,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Border" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 🤖 Enhanced Rich AI Side Preview Pane -->
                <Border x:Name="AiPreviewPane" Grid.Column="1" Width="380" Margin="10,2,10,2"
                        Background="#252528" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1"
                        Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> 
                            <RowDefinition Height="*"/>    
                            <RowDefinition Height="Auto"/> 
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#007ACC" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="🤖 Spotlight AI Response" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Formatted RichTextBox -->
                        <RichTextBox x:Name="AiPreviewBox" Grid.Row="1" Background="Transparent" 
                                     BorderThickness="0" Foreground="#E0E0E0" FontSize="13" 
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>

                        <!-- Footer -->
                        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <TextBlock Text="↵ Enter to copy response" Foreground="#888888" FontSize="11" HorizontalAlignment="Right"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>