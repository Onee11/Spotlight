<Window x:Class="SpotlightWin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniLaunch" 
        Height="600" Width="800"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    
    <Border Background="#CC1E1E1E" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" 
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="24" Foreground="White" Background="Transparent" 
                     BorderThickness="0" VerticalContentAlignment="Center" Padding="20,0,20,0"
                     CaretBrush="White" x:Name="SearchBox">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ExecuteSelectedCommand}" />
                </TextBox.InputBindings>
            </TextBox>
                     
            <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#33FFFFFF"/>
            
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding Results}" 
                     SelectedItem="{Binding SelectedResult}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,5,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Display Real App Icon -->
                                <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Rectangle Width="24" Height="24" Fill="#22FFFFFF" RadiusX="4" RadiusY="4"/>
                                    <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#AAAAAA"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Margin" Value="5,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Border" CornerRadius="6" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</Window>